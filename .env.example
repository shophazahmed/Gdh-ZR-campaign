# Single portal with systemd: copy to /etc/voter-portal/env, chmod 600.
# Many candidates with Docker: don't copy this; deploy/vp.sh new writes candidates/<slug>/.env.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
VOTER_PORTAL_SECRET_KEY=change-me
# Where the SQLite database and photos live
VOTER_PORTAL_DATA_DIR=/var/lib/voter-portal
# Gunicorn listen address (Nginx proxies to it)
GUNICORN_BIND=127.0.0.1:8001
# Docker + Traefik only: must match the names in your Traefik config
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
# Short campaign name for the title bar and sign-in page (admins can change it under Settings)
VOTER_PORTAL_CAMPAIGN_NAME=Gadhdhoo
